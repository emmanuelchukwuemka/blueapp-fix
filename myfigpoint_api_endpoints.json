        }
      },
      "getTasks": {
        "method": "GET",
        "url": "/admin/tasks",
        "description": "Get all tasks (admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "response": {
          "tasks": "array"
        }
      },
      "createTask": {
        "method": "POST",
        "url": "/admin/tasks",
        "description": "Create a task (admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requestBody": {
          "title": "string",
          "description": "string",
          "reward_amount": "number",
          "points_reward": "number",
          "category": "string",
          "time_required": "number",
          "is_active": "boolean",
          "requires_admin_verification": "boolean"
        },
        "response": {
          "message": "string",
          "task": "object"
        }
      },
      "updateTask": {
        "method": "PUT",
        "url": "/admin/tasks/{task_id}",
        "description": "Update a task (admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "requestBody": {
          "title": "string",
          "description": "string",
          "reward_amount": "number",
          "points_reward": "number",
          "category": "string",
          "time_required": "number",
          "is_active": "boolean",
          "requires_admin_verification": "boolean"
        },
        "response": {
          "message": "string",
          "task": "object"
        }
