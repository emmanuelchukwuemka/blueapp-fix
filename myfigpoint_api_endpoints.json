{
  "baseUrl": "http://72.62.4.119/api",
  "apiInfo": {
    "name": "MyFigPoint API",
    "version": "1.0.0",
    "description": "Backend API for MyFigPoint application deployed at 72.62.4.119"
  },
  "endpoints": {
    "authentication": {
      "login": {
        "method": "POST",
        "url": "/auth/login",
        "description": "User login",
        "requiresAuth": false,
        "requestBody": {
          "email": "string",
          "password": "string"
        },
        "response": {
          "token": "string",
          "user": "object"
        }
      },
      "signup": {
        "method": "POST",
        "url": "/auth/signup",
        "description": "User registration",
        "requiresAuth": false,
        "requestBody": {
          "full_name": "string",
          "email": "string",
          "password": "string",
          "phone": "string"
        },
        "response": {
          "message": "string",
          "user": "object"
        }
      },
      "forgotPassword": {
        "method": "POST",
        "url": "/auth/forgot-password",
        "description": "Forgot password",
        "requiresAuth": false,
        "requestBody": {
          "email": "string"
        },
        "response": {
          "message": "string"
        }
      },
      "resetPassword": {
        "method": "POST",
        "url": "/auth/reset-password",
        "description": "Reset password",
        "requiresAuth": false,
        "requestBody": {
          "token": "string",
          "new_password": "string"
        },
        "response": {
          "message": "string"
        }
      }
    },
    "user": {
      "getProfile": {
        "method": "GET",
        "url": "/users/profile",
        "description": "Get user profile",
        "requiresAuth": true,
        "response": {
          "user": "object"
        }
      },
      "updateProfile": {
        "method": "PUT",
        "url": "/users/profile",
        "description": "Update user profile",
        "requiresAuth": true,
        "requestBody": {
          "full_name": "string",
          "phone": "string",
          "bank_name": "string",
          "account_name": "string",
          "account_number": "string"
        },
        "response": {
          "message": "string",
          "user": "object"
        }
      },
      "getUsers": {
        "method": "GET",
        "url": "/users/",
        "description": "Get users list (admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "response": {
          "users": "array"
        }
      }
    },
    "points": {
      "getBalance": {
        "method": "GET",
        "url": "/points/balance",
        "description": "Get user's points balance",
        "requiresAuth": true,
        "response": {
          "balance": "number",
          "total_earned": "number",
          "total_withdrawn": "number"
        }
      },
      "getHistory": {
        "method": "GET",
        "url": "/points/history",
        "description": "Get points history",
        "requiresAuth": true,
        "response": {
          "history": "array"
        }
