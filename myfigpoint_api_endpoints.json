          "proof_image": "string"
        },
        "response": {
          "message": "string",
          "points_awarded": "number",
          "reward_awarded": "number",
          "new_points_balance": "number",
          "new_total_earnings": "number"
        }
      }
    },
    "notifications": {
      "getNotifications": {
        "method": "GET",
        "url": "/notifications/",
        "description": "Get user notifications",
        "requiresAuth": true,
        "response": {
          "notifications": "array"
        }
      },
      "createNotification": {
        "method": "POST",
        "url": "/notifications/",
        "description": "Create notification",
        "requiresAuth": true,
        "requestBody": {
          "title": "string",
          "message": "string",
          "type": "string"
        },
        "response": {
          "message": "string",
          "notification": "object"
        }
      }
    },
    "support": {
      "getTickets": {
        "method": "GET",
        "url": "/support/tickets",
        "description": "Get support tickets",
        "requiresAuth": true,
        "response": {
          "tickets": "array"
        }
