        "requiresAuth": true,
        "requestBody": {
          "subject": "string",
          "message": "string",
          "category": "string"
        },
        "response": {
          "message": "string",
          "ticket": "object"
        }
      }
    },
    "partners": {
      "getPartners": {
        "method": "GET",
        "url": "/partners/",
        "description": "Get partner information",
        "requiresAuth": true,
        "response": {
          "partners": "array"
        }
      },
      "registerPartner": {
        "method": "POST",
        "url": "/partners/",
        "description": "Partner registration",
        "requiresAuth": true,
        "requestBody": {
          "business_name": "string",
          "business_type": "string",
          "contact_info": "string"
        },
        "response": {
          "message": "string",
          "partner": "object"
        }
      }
    },
    "admin": {
      "getUsers": {
        "method": "GET",
        "url": "/admin/users",
