        "requiresAuth": true,
        "response": {
          "codes": "array"
        }
      },
      "redeemCode": {
        "method": "POST",
        "url": "/codes/redeem",
        "description": "Redeem a code",
        "requiresAuth": true,
        "requestBody": {
          "code": "string"
        },
        "response": {
          "message": "string",
          "points_awarded": "number"
        }
      }
    },
    "transactions": {
      "getHistory": {
        "method": "GET",
        "url": "/transactions/",
        "description": "Get transaction history",
        "requiresAuth": true,
        "response": {
          "transactions": "array"
        }
      }
    },
    "referrals": {
      "getReferrals": {
        "method": "GET",
        "url": "/referrals/",
        "description": "Get referral information",
        "requiresAuth": true,
        "response": {
          "referrals": "array",
          "referral_code": "string",
          "referral_count": "number",
          "total_earnings": "number"
        }
      }
    },
    "tasks": {
      "getTasks": {
        "method": "GET",
        "url": "/tasks/",
        "description": "Get available tasks",
        "requiresAuth": true,
        "response": {
          "tasks": "array",
          "total": "number",
          "pages": "number",
          "current_page": "number"
        }
      },
      "startTask": {
        "method": "POST",
        "url": "/tasks/{task_id}/start",
        "description": "Start a task",
        "requiresAuth": true,
        "requestBody": {},
        "response": {
          "message": "string",
          "task": "object",
          "user_task": "object"
        }
      },
      "completeTask": {
        "method": "POST",
        "url": "/tasks/{task_id}/complete",
        "description": "Complete a task",
