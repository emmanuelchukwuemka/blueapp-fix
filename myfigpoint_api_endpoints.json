      "deleteTask": {
        "method": "DELETE",
        "url": "/admin/tasks/{task_id}",
        "description": "Delete a task (admin only)",
        "requiresAuth": true,
        "adminOnly": true,
        "response": {
          "message": "string"
        }
      }
